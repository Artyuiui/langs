#!/bin/bash
# langs — GitHub-style language breakdown (by bytes) of a project. Usage: langs [dir]
cd "${1:-.}" || exit 1

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  files() { git ls-files -z --cached --others --exclude-standard; }   # respects .gitignore like GitHub
else
